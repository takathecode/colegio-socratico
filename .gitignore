# Segredos: senha do banco e SECRET_KEY ficam só na máquina de cada desenvolvedor
.env

# Ambiente virtual do Python
.venv/

# Arquivos gerados pelo Python
__pycache__/
*.py[cod]

# Banco SQLite local, caso seja criado
*.sqlite3

# Arquivos estáticos coletados e anexos enviados pelos usuários
staticfiles/
media/

# Modelo treinado (ml/modelo_evasao.joblib): VAI para o Git (cerca de 1,3 MB), para a Vercel
# ter o arquivo sem precisar treinar no build. Treinou de novo? Faça commit do arquivo novo.

# Configurações pessoais do Claude Code
.claude/settings.local.json

# Windows
Thumbs.db

# Dependências do Node (recriadas com npm install)
node_modules/

# Vercel: pasta criada pela CLI e variáveis baixadas com "vercel env pull"
.vercel/
.env*.local

# Instaladores e executáveis não vão para o repositório
*.exe
