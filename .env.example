# Copie este arquivo para ".env" e preencha os valores.
# O .env fica fora do Git. Nunca coloque valores reais neste arquivo de exemplo.

# Chave secreta do Django. Para gerar uma nova:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True em desenvolvimento. False em produção.
DEBUG=True

# Endereços que podem acessar o sistema, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexão com o Supabase: botão "Connect" do painel > Session pooler > URI.
# Troque SUA_SENHA pela senha do banco e copie o host exatamente como aparece no painel.
# Se a senha tiver caracteres especiais (@ : / ? #), ela precisa estar codificada para URL.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@SEU_HOST.pooler.supabase.com:5432/postgres?sslmode=require
