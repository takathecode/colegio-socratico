# Copie este arquivo para ".env" e preencha os valores.
# O .env fica fora do Git. Nunca coloque valores reais neste arquivo de exemplo.

# Chave secreta do Django. Para gerar uma nova:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True em desenvolvimento. False em produção.
DEBUG=True

# Endereços que podem acessar o sistema, separados por vírgula.
# Na Vercel, acrescente o domínio do projeto (ex.: .vercel.app, com o ponto na frente).
ALLOWED_HOSTS=localhost,127.0.0.1

# True somente no servidor publicado (Vercel), que usa https://.
# No computador deixe False: com True o login não funciona em http://127.0.0.1.
USAR_HTTPS=False

# Conexão com o Supabase: botão "Connect" do painel > Session pooler > URI.
# Troque SUA_SENHA pela senha do banco e copie o host exatamente como aparece no painel.
# Se a senha tiver caracteres especiais (@ : / ? #), ela precisa estar codificada para URL.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@SEU_HOST.pooler.supabase.com:5432/postgres?sslmode=require

# E-mail (opcional). Sem estas linhas, a mensagem de redefinição de senha aparece no terminal.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=Instituto Socrático <nao-responda@exemplo.com>

# Endereço do sistema, usado nos links dos e-mails de alerta.
# ENDERECO_DO_SITE=http://127.0.0.1:8000

# Redis, a fila do Celery (alertas automáticos).
# Local (Docker): redis://localhost:6379/0
# Upstash: copie a URL "rediss://default:SENHA@HOST.upstash.io:6379" do painel.
REDIS_URL=redis://localhost:6379/0

# True roda as tarefas na hora, sem fila: use em um computador sem Redis.
# A rotina agendada (beat) só funciona com False e com o Redis no ar.
CELERY_SEM_REDIS=False
